{
  "name": "harness",
  "version": "0.9.1",
  "description": "Multi-provider AI chat + agent harness (OpenRouter, OpenAI-compatible, Ollama, MCP)",
  "main": "out/main/index.mjs",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder",
    "test": "node --import tsx test/files.harness.mjs && node --import tsx test/extract.harness.mjs && node --import tsx test/imagemap.harness.mjs && node --import tsx test/imaging.harness.mjs"
  },
  "build": {
    "appId": "dev.local.harness",
    "productName": "Koshirae AI",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Koshirae AI uses the microphone for voice dictation."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "0.73.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.5.18",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  }
}
